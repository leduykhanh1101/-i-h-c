@model IEnumerable<KhanhAndPhuDictionary.Models.Favorite>

@{
    Layout = "_Layout";
}

<script src="https://cdn.tailwindcss.com"></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 bg-[#fcfcff] min-h-screen">
    <div class="flex justify-between items-end mb-10">
        <div>
            <h1 class="text-4xl font-extrabold text-slate-900 tracking-tight">My Favorites</h1>
            <p class="text-slate-500 mt-2 font-medium">Bạn có <span class="text-violet-600">@Model.Count()</span> từ vựng đã lưu</p>
        </div>
        <a href="/" class="flex items-center gap-2 text-violet-600 font-bold hover:text-indigo-700 transition-all">
            <i class="bi bi-plus-circle-fill"></i>
            Search New Word
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="bg-white rounded-[2.5rem] p-20 shadow-sm border border-slate-100 text-center">
            <div class="w-20 h-20 bg-slate-50 text-slate-300 rounded-3xl flex items-center justify-center mx-auto mb-6">
                <i class="bi bi-bookmark-dash text-4xl"></i>
            </div>
            <h3 class="text-xl font-bold text-slate-900">Chưa có từ vựng nào</h3>
            <p class="text-slate-400 mt-2">Hãy tra cứu và lưu lại những từ vựng yêu thích của bạn nhé!</p>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            @foreach (var item in Model)
            {
                <div id="card-@item.Id" class="bg-white rounded-[2rem] p-6 shadow-sm border border-slate-100 hover:shadow-md transition-all group">
                    <div class="flex justify-between items-start mb-4">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 bg-violet-50 text-violet-600 rounded-xl flex items-center justify-center font-bold">
                                @item.Word.Substring(0, 1).ToUpper()
                            </div>
                            <h4 class="text-xl font-extrabold text-slate-900 capitalize">@item.Word</h4>
                        </div>
                        <button onclick="removeFavorite(@item.Id, '@item.Word')" 
                                class="text-slate-300 hover:text-red-500 transition-colors">
                            <i class="bi bi-trash3-fill"></i>
                        </button>
                    </div>

                    <div class="flex gap-2 mb-6">
                        <a href="/Dictionary/Search?word=@item.Word" 
                           class="flex-grow bg-slate-50 text-slate-600 font-bold py-3 rounded-xl text-center hover:bg-violet-600 hover:text-white transition-all text-sm">
                            Xem chi tiết
                        </a>
                    </div>
                </div>
            }
        </div>
    }
</div>

<script>
function removeFavorite(id, wordValue) {
    if (!confirm(`Bạn có chắc muốn xóa từ "${wordValue}"?`)) return;

    fetch('/Dictionary/ToggleFavorite', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: `word=${encodeURIComponent(wordValue)}`
    })
    .then(response => response.json())
    .then(data => {
        if (data.success && !data.isFavorite) {
            const card = document.getElementById(`card-${id}`);
            card.style.opacity = '0';
            card.style.transform = 'scale(0.9)';
            setTimeout(() => {
                card.remove();
                if (document.querySelectorAll('[id^="card-"]').length === 0) {
                    location.reload();
                }
            }, 300);
        }
    })
    .catch(error => console.error('Error:', error));
}
</script>