@{
    Layout = null; 
}
<!DOCTYPE html>
<html>
<head>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>body { font-family: 'Plus Jakarta Sans', sans-serif; }</style>
</head>
<body class="bg-white">

    <div class="flex min-h-screen">
        <div class="hidden lg:flex w-1/2 bg-[#F2F0FF] p-16 flex-col justify-between relative overflow-hidden">
            <div class="z-10">
                <div class="flex items-center gap-2 mb-16">
                    <div class="w-8 h-8 bg-violet-700 rounded-lg flex items-center justify-center">
                        <i class="bi bi-book-half text-white"></i>
                    </div>
                    <span class="text-2xl font-bold text-slate-900 tracking-tight">KhanhAndPhu</span>
                </div>

                <h1 class="text-6xl font-bold leading-tight text-slate-900 mb-6">
                    Master every word with <span class="text-violet-700">KhanhAndPhu.</span>
                </h1>
                <p class="text-slate-500 text-lg max-w-md">
                    Join over 2 million learners improving their vocabulary, writing, and communication every day.
                </p>
            </div>

            <div class="relative z-10 flex justify-center">
                <div class="bg-white/40 p-4 rounded-[2.5rem] backdrop-blur-sm border border-white/50 shadow-2xl">
                    <img src="https://images.unsplash.com/photo-1456513080510-7bf3a84b82f8?auto=format&fit=crop&q=80&w=800" 
                         class="rounded-[2rem] w-[400px] h-[400px] object-cover" alt="Reading">
                </div>
            </div>

            <div class="z-10 flex items-center gap-4">
                <div class="flex -space-x-3">
                    <img class="w-10 h-10 rounded-full border-2 border-white" src="https://ui-avatars.com/api/?name=A&background=random" alt="">
                    <img class="w-10 h-10 rounded-full border-2 border-white" src="https://ui-avatars.com/api/?name=B&background=random" alt="">
                    <img class="w-10 h-10 rounded-full border-2 border-white" src="https://ui-avatars.com/api/?name=C&background=random" alt="">
                </div>
                <p class="text-sm text-slate-500 font-medium">Trusted by language experts worldwide.</p>
            </div>
        </div>

        <div class="w-full lg:w-1/2 flex flex-col justify-center px-8 md:px-24 lg:px-32 relative">
            
            <div class="max-w-md w-full mx-auto">
                <h2 class="text-4xl font-bold text-slate-900 mb-2">Welcome Back</h2>
                <p class="text-slate-500 mb-8">Please enter your details to sign in.</p>

                @if (ViewBag.Error != null)
                {
                    <div class="mb-6 p-4 bg-red-50 border-l-4 border-red-500 text-red-700 text-sm font-medium rounded-r-lg">
                        <i class="bi bi-exclamation-circle-fill mr-2"></i> @ViewBag.Error
                    </div>
                }

                <form action="/Account/Login" method="post" class="space-y-6">
                    <div>
                        <label class="block text-sm font-bold text-slate-700 mb-2">Email Address</label>
                        <input type="email" name="email" required placeholder="name@company.com" 
                               class="w-full px-4 py-4 rounded-xl border border-slate-200 focus:outline-none focus:ring-4 focus:ring-violet-100 focus:border-violet-600 transition-all">
                    </div>

                    <div>
                        <div class="flex justify-between mb-2">
                            <label class="text-sm font-bold text-slate-700">Password</label>
                            <a href="#" class="text-sm font-bold text-violet-700 hover:text-violet-800">Forgot password?</a>
                        </div>
                        <div class="relative">
                            <input type="password" name="password" required placeholder="••••••••" 
                                   class="w-full px-4 py-4 rounded-xl border border-slate-200 focus:outline-none focus:ring-4 focus:ring-violet-100 focus:border-violet-600 transition-all">
                        </div>
                    </div>

                    <div class="flex items-center gap-2">
                        <input type="checkbox" id="remember" class="w-4 h-4 rounded border-slate-300 text-violet-600 focus:ring-violet-600">
                        <label for="remember" class="text-sm font-medium text-slate-600">Remember me for 30 days</label>
                    </div>

                    <button type="submit" class="w-full bg-violet-700 text-white py-4 rounded-xl font-bold text-lg hover:bg-violet-800 transition-all shadow-lg shadow-violet-200 active:scale-[0.98]">
                        Sign In
                    </button>
                </form>

                <p class="mt-8 text-center text-slate-600">
                    Don't have an account? <a href="/Account/Register" class="text-violet-700 font-bold hover:underline">Create an account</a>
                </p>
            </div>

            <div class="absolute bottom-8 left-0 right-0 text-center text-slate-400 text-xs tracking-widest uppercase">
                © 2026 KhanhAndPhu DICTIONARY. ALL RIGHTS RESERVED.
            </div>
        </div>
    </div>

</body>
</html>