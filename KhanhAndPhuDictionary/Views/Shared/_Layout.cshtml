<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>KhanhAndPhu - Dictionary</title>
    
    <script src="https://cdn.tailwindcss.com"></script>
    
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
          rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    
    <style>
        body {
        font-family: 'Plus Jakarta Sans', sans-serif;
        }
    </style>
</head>

<body class="bg-[#F9FAFB] flex flex-col min-h-screen">

    <header class="bg-white border-b border-gray-100 sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 h-20 flex items-center justify-between">
            <a href="/" class="flex items-center gap-2">
                <div
                    class="w-10 h-10 bg-violet-700 rounded-xl flex items-center justify-center text-white shadow-lg shadow-violet-200">
                    <i class="bi bi-book-half text-xl"></i>
                </div>
                <span class="text-2xl font-bold text-slate-900 tracking-tight">KhanhAndPhu</span>
            </a>

            <nav class="hidden md:flex items-center gap-8 text-sm font-semibold text-slate-600">
                <a href="/" class="hover:text-violet-700 transition-colors">Dictionary</a>
                <li>
                    <a asp-controller="Dictionary" asp-action="MyFavorites"
                           class="hover:text-violet-700 transition-colors">
                        My Favorites
                    </a>
                </li>
                <a href="#" class="hover:text-violet-700 transition-colors">Grammar</a>
                <a href="#" class="hover:text-violet-700 transition-colors text-violet-600">Word of the Day</a>
            </nav>

            <div class="flex items-center gap-4">
                @using Microsoft.AspNetCore.Http
            @if (Context.Session.GetString("Username") != null)
                {
                    <div class="flex items-center gap-3">
                        <div class="text-right hidden sm:block">
                            <p class="text-xs text-gray-400 font-bold uppercase tracking-wider">Welcome</p>
                            <p class="text-sm font-bold text-slate-900">@Context.Session.GetString("Username")</p>
                        </div>
                        <div class="relative group">
                            <button
                                class="w-10 h-10 bg-violet-100 rounded-full flex items-center justify-center text-violet-700 border-2 border-white shadow-sm">
                                <i class="bi bi-person-fill"></i>
                            </button>
                            <div
                                class="absolute right-0 mt-2 w-48 bg-white rounded-xl shadow-xl border border-gray-100 hidden group-hover:block">
                                <a href="/Account/Logout"
                                       class="block px-4 py-3 text-sm text-red-600 font-bold hover:bg-red-50 rounded-xl transition-colors">
                                    <i class="bi bi-box-arrow-right mr-2"></i> Sign Out
                                </a>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <a href="/Account/Login"
                       class="text-sm font-bold text-slate-700 hover:text-violet-700 px-2 transition-colors">Sign In</a>
                    <a href="/Account/Register"
                           class="bg-violet-700 text-white px-6 py-3 rounded-xl font-bold text-sm hover:bg-indigo-900 transition-all shadow-lg shadow-violet-200">
                        Sign Up
                    </a>
                }
            </div>
        </div>
    </header>

    <main class="flex-grow">
        @RenderBody()
    </main>

    <footer class="bg-white border-t border-gray-100 pt-16 pb-8">
        <div class="max-w-7xl mx-auto px-4">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-12 mb-16">
                <div class="col-span-1 md:col-span-1">
                    <div class="flex items-center gap-2 mb-6">
                        <div class="w-8 h-8 bg-violet-700 rounded-lg flex items-center justify-center text-white">
                            <i class="bi bi-book-half"></i>
                        </div>
                        <span class="text-xl font-bold text-slate-900">KhanhAndPhu</span>
                    </div>
                    <p class="text-gray-500 text-sm leading-relaxed mb-6">
                        The world's most trusted dictionary and thesaurus platform. Join 2 million learners today.
                    </p>
                    <div class="flex gap-4">
                        <a href="#" class="text-gray-400 hover:text-violet-600 text-xl"><i
                            class="bi bi-facebook"></i></a>
                            <a href="#" class="text-gray-400 hover:text-violet-600 text-xl"><i
                                class="bi bi-twitter-x"></i></a>
                                <a href="#" class="text-gray-400 hover:text-violet-600 text-xl"><i
                                    class="bi bi-instagram"></i></a>
                                </div>
                            </div>

                            <div>
                                <h4 class="font-bold text-slate-900 mb-6 uppercase text-xs tracking-widest">Resources</h4>
                                <ul class="text-sm text-gray-500 space-y-4">
                                    <li><a href="#" class="hover:text-violet-700 transition-colors">Online Dictionary</a></li>
                                    <li>
                                        <a asp-controller="Dictionary" asp-action="MyFavorites"
                                               class="hover:text-violet-700 transition-colors">
                                            My Favorites
                                        </a>
                                    </li>
                                    <li><a href="#" class="hover:text-violet-700 transition-colors">Grammar Guide</a></li>
                                    <li><a href="#" class="hover:text-violet-700 transition-colors">Word Lists</a></li>
                                </ul>
                            </div>

                            <div>
                                <h4 class="font-bold text-slate-900 mb-6 uppercase text-xs tracking-widest">Company</h4>
                                <ul class="text-sm text-gray-500 space-y-4">
                                    <li><a href="#" class="hover:text-violet-700 transition-colors">About Us</a></li>
                                    <li><a href="#" class="hover:text-violet-700 transition-colors">Contact Support</a></li>
                                    <li><a href="#" class="hover:text-violet-700 transition-colors">Privacy Policy</a></li>
                                    <li><a href="#" class="hover:text-violet-700 transition-colors">Terms of Service</a></li>
                                </ul>
                            </div>

                            <div>
                                <h4 class="font-bold text-slate-900 mb-6 uppercase text-xs tracking-widest">Newsletter</h4>
                                <p class="text-sm text-gray-500 mb-4">Get the word of the day in your inbox.</p>
                                <div class="flex gap-2">
                                    <input type="email" placeholder="Email address"
                                           class="bg-gray-50 border border-gray-100 rounded-lg px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-violet-200 w-full">
                                    <button class="bg-slate-900 text-white p-2 rounded-lg hover:bg-black transition-colors">
                                        <i class="bi bi-send"></i>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <div
                            class="pt-8 border-t border-gray-50 flex flex-col md:flex-row justify-between items-center gap-4 text-[11px] font-bold text-slate-400 tracking-widest uppercase">
                            <p>© 2026 KhanhAndPhu DICTIONARY. ALL RIGHTS RESERVED.</p>
                            <div class="flex gap-8">
                                <a href="#" class="hover:text-slate-600">Privacy</a>
                                <a href="#" class="hover:text-slate-600">Cookies</a>
                                <a href="#" class="hover:text-slate-600">Security</a>
                            </div>
                        </div>
                    </div>
                </footer>

                @await RenderSectionAsync("Scripts", required: false)
            </body>

        </html>